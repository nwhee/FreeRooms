# URL the UI fetches schedule.json from at runtime (FR-0, FR-5).
# Unset or empty: the UI fetches /data/schedule.json, the local file written by
#   `npm run fetch-data` (gitignored).
# Production: the raw URL of the `data` branch,
#   https://raw.githubusercontent.com/nwhee/FreeRooms/data/schedule.json
#   A human sets it in Vercel. It is inlined at build time, so changing it needs a
#   redeploy through scripts/deploy/.
NEXT_PUBLIC_DATA_URL=
